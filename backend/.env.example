# Copia este archivo como .env y cambia los valores.
DJANGO_SECRET_KEY=Inspira123$
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL local
DB_NAME=inspira
DB_USER=root
DB_PASSWORD=Inspira123$
DB_HOST=127.0.0.1
DB_PORT=3306

# En el servidor puedes usar una sola variable en lugar de las DB_*:
# DATABASE_URL=mysql://usuario:contraseña@host:3306/inspira

# Direcciones del frontend que pueden usar la API (separadas por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
